<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Who sees which site ──
             Staff and managers see the sites they are listed on; admins see
             all. Every satellite model follows its location. -->

        <record id="rule_location_user" model="ir.rule">
            <field name="name">Location: staff see their sites</field>
            <field name="model_id" ref="model_restaurant_location"/>
            <field name="domain_force">['|', ('staff_user_ids', 'in', [user.id]), ('manager_user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_location_user'))]"/>
        </record>
        <record id="rule_location_manager" model="ir.rule">
            <field name="name">Location: managers see their sites</field>
            <field name="model_id" ref="model_restaurant_location"/>
