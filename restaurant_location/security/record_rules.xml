            <field name="groups" eval="[(4, ref('group_location_manager'))]"/>
        </record>
        <record id="rule_location_admin" model="ir.rule">
            <field name="name">Location: admins see all</field>
            <field name="model_id" ref="model_restaurant_location"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_location_admin'))]"/>
        </record>

