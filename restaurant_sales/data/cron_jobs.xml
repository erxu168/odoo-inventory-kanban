<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_generate_daily_entries" model="ir.cron">
            <field name="name">Restaurant Sales: Open Yesterday's Entries</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_remind_pending" model="ir.cron">
            <field name="name">Restaurant Sales: Chase Unsubmitted Days</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_pending()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
