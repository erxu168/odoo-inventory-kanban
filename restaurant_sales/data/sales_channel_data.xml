<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="channel_delivery_platform" model="restaurant.sales.channel">
            <field name="name">Delivery Platform</field>
            <field name="code">DELIVERY</field>
            <field name="sequence">10</field>
            <field name="commission_percent">25.0</field>
            <field name="company_id" eval="False"/>
            <field name="note">Rename or duplicate this per platform (Uber Eats, Deliveroo, Talabat…) and set each one's real commission.</field>
        </record>

        <record id="channel_catering" model="restaurant.sales.channel">
            <field name="name">Catering &amp; Events</field>
            <field name="code">CATERING</field>
            <field name="sequence">20</field>
            <field name="commission_percent">0.0</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="channel_phone_orders" model="restaurant.sales.channel">
            <field name="name">Phone / Walk-in Pickup</field>
            <field name="code">PHONE</field>
            <field name="sequence">30</field>
            <field name="commission_percent">0.0</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
