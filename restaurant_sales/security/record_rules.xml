<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Staff close out the outlets they are listed on, or the entries
             they opened themselves. -->
        <record id="rule_sales_entry_staff" model="ir.rule">
            <field name="name">Sales Entry: staff see own outlets</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="domain_force">
                ['|', '|',
                 ('user_id', '=', user.id),
                 ('pos_config_id.sales_staff_ids', 'in', [user.id]),
                 ('pos_config_id.sales_manager_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('group_sales_staff'))]"/>
        </record>

        <record id="rule_sales_entry_manager" model="ir.rule">
            <field name="name">Sales Entry: managers see their outlets</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="domain_force">
                ['|', '|',
                 ('user_id', '=', user.id),
                 ('pos_config_id.sales_staff_ids', 'in', [user.id]),
                 ('pos_config_id.sales_manager_ids', 'in', [user.id])]
            </field>
            <field name="groups" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

        <record id="rule_sales_entry_admin" model="ir.rule">
            <field name="name">Sales Entry: admins see everything</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sales_admin'))]"/>
        </record>

        <!-- Multi-company: never leak another company's takings. -->
        <record id="rule_sales_entry_company" model="ir.rule">
            <field name="name">Sales Entry: multi-company</field>
            <field name="model_id" ref="model_restaurant_sales_entry"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="rule_sales_channel_company" model="ir.rule">
            <field name="name">Sales Channel: multi-company</field>
            <field name="model_id" ref="model_restaurant_sales_channel"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
