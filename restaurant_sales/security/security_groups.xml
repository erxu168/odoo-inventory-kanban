<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_restaurant_sales" model="ir.module.category">
            <field name="name">Restaurant Sales</field>
            <field name="sequence">51</field>
        </record>

        <record id="privilege_restaurant_sales" model="res.groups.privilege">
            <field name="name">Restaurant Sales</field>
            <field name="sequence">51</field>
            <field name="category_id" ref="module_category_restaurant_sales"/>
        </record>

        <record id="group_sales_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="sequence">10</field>
            <field name="comment">Close out own outlets and submit the day's takings</field>
            <field name="privilege_id" ref="privilege_restaurant_sales"/>
        </record>

        <record id="group_sales_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="comment">Approve daily sales for the outlets they manage</field>
            <field name="privilege_id" ref="privilege_restaurant_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_staff'))]"/>
        </record>

        <record id="group_sales_admin" model="res.groups">
            <field name="name">Owner / Admin</field>
            <field name="sequence">30</field>
            <field name="comment">Full access across every outlet</field>
            <field name="privilege_id" ref="privilege_restaurant_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_manager'))]"/>
        </record>

    </data>
</odoo>
