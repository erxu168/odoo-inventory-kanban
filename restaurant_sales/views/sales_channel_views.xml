<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_channel_list" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.list</field>
        <field name="model">restaurant.sales.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="commission_percent"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_sales_channel_form" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.form</field>
        <field name="model">restaurant.sales.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Uber Eats"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="commission_percent"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sales_channel_search" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.search</field>
        <field name="model">restaurant.sales.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_sales_channel" model="ir.actions.act_window">
        <field name="name">Sales Channels</field>
        <field name="res_model">restaurant.sales.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a revenue channel
            </p>
            <p>
                Channels capture revenue that never passes through the POS
                terminal — delivery platforms, catering, events — together
                with the commission each one keeps.
            </p>
        </field>
    </record>

    <!-- Channel mix reporting, on the daily lines rather than the entries. -->
    <record id="view_sales_channel_line_pivot" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.line.pivot</field>
        <field name="model">restaurant.sales.channel.line</field>
        <field name="arch" type="xml">
            <pivot string="Channel Mix" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="channel_id" type="col"/>
                <field name="gross_amount" type="measure"/>
                <field name="net_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sales_channel_line_graph" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.line.graph</field>
        <field name="model">restaurant.sales.channel.line</field>
        <field name="arch" type="xml">
            <graph string="Channel Mix" type="bar" sample="1">
                <field name="channel_id"/>
                <field name="gross_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_sales_channel_line_list" model="ir.ui.view">
        <field name="name">restaurant.sales.channel.line.list</field>
        <field name="model">restaurant.sales.channel.line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="date"/>
                <field name="entry_id"/>
                <field name="channel_id"/>
                <field name="order_count" sum="Orders"/>
                <field name="gross_amount" sum="Gross"/>
                <field name="commission_amount" sum="Commission"/>
                <field name="net_amount" sum="Net"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_sales_channel_line" model="ir.actions.act_window">
        <field name="name">Channel Mix</field>
        <field name="res_model">restaurant.sales.channel.line</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

</odoo>
