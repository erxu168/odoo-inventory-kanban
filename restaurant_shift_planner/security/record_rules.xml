<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Staff see their own attribute values and nobody else's: levels
             and certifications are personal data. -->
        <record id="rule_attribute_value_own" model="ir.rule">
            <field name="name">Attribute Value: staff see own</field>
            <field name="model_id" ref="model_restaurant_staff_attribute_value"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shift_planner_user'))]"/>
        </record>

        <record id="rule_attribute_value_manager" model="ir.rule">
            <field name="name">Attribute Value: planners see all</field>
            <field name="model_id" ref="model_restaurant_staff_attribute_value"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shift_planner_manager'))]"/>
        </record>

    </data>
</odoo>
