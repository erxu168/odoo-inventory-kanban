<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_shift_planning" model="ir.module.category">
            <field name="name">Shift Planning</field>
            <field name="sequence">51</field>
        </record>

        <record id="privilege_shift_planning" model="res.groups.privilege">
            <field name="name">Shift Planning</field>
            <field name="sequence">51</field>
            <field name="category_id" ref="module_category_shift_planning"/>
        </record>

        <record id="group_shift_planner_user" model="res.groups">
            <field name="name">Staff</field>
            <field name="sequence">10</field>
            <field name="comment">See own shift attributes</field>
            <field name="privilege_id" ref="privilege_shift_planning"/>
        </record>

        <record id="group_shift_planner_manager" model="res.groups">
            <field name="name">Shift Planner</field>
            <field name="sequence">20</field>
            <field name="comment">Define attributes and shift requirements, run the gap report</field>
            <field name="privilege_id" ref="privilege_shift_planning"/>
            <field name="implied_ids" eval="[(4, ref('group_shift_planner_user'))]"/>
        </record>

    </data>
</odoo>
