<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_shift_requirement_list" model="ir.ui.view">
        <field name="name">restaurant.shift.requirement.list</field>
        <field name="model">restaurant.shift.requirement</field>
        <field name="arch" type="xml">
            <list decoration-muted="enforcement == 'soft'">
                <field name="sequence" widget="handle"/>
                <field name="template_id" string="Shift Template"/>
                <field name="name" string="Requirement"/>
                <field name="scope"/>
                <field name="role_id" optional="show"/>
                <field name="enforcement"/>
                <field name="weight" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_shift_requirement_form" model="ir.ui.view">
        <field name="name">restaurant.shift.requirement.form</field>
        <field name="model">restaurant.shift.requirement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Applies To">
                            <field name="template_id"
                                   placeholder="Every shift"/>
                            <field name="role_id" placeholder="Every role"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <label for="day_mon" string="Only On"/>
                            <div>
                                <field name="day_mon" class="oe_inline"/><label for="day_mon"/>
                                <field name="day_tue" class="oe_inline"/><label for="day_tue"/>
                                <field name="day_wed" class="oe_inline"/><label for="day_wed"/>
                                <field name="day_thu" class="oe_inline"/><label for="day_thu"/>
                                <field name="day_fri" class="oe_inline"/><label for="day_fri"/>
                                <field name="day_sat" class="oe_inline"/><label for="day_sat"/>
                                <field name="day_sun" class="oe_inline"/><label for="day_sun"/>
                                <div class="text-muted">Tick nothing for every day.</div>
                            </div>
                        </group>
                        <group string="The Test">
                            <field name="attribute_id"/>
                            <field name="value_type" invisible="1"/>
                            <field name="scope"/>
                            <field name="operator"/>
                            <field name="value"
                                   invisible="operator in ('is_true', 'is_valid')"/>
                        </group>
                    </group>
                    <group string="How The Crew Is Measured" invisible="scope != 'team'">
                        <group>
                            <field name="aggregate"/>
                            <field name="min_count" invisible="aggregate != 'count'"/>
                            <field name="use_max_count" invisible="aggregate != 'count'"/>
                            <field name="max_count"
                                   invisible="aggregate != 'count' or not use_max_count"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                A crew rule is checked once over everyone whose
                                shift overlaps this one, across roles and
                                templates — that is what makes "one keyholder
                                on shift" work when the keyholder is behind the
                                bar and the rule sits on the service template.
                            </div>
                        </group>
                    </group>
                    <group string="Enforcement">
                        <group>
                            <field name="enforcement"/>
                            <field name="weight" invisible="enforcement != 'soft'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="message"
                                   placeholder="Leave empty to use the generated wording"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shift_requirement_search" model="ir.ui.view">
        <field name="name">restaurant.shift.requirement.search</field>
        <field name="model">restaurant.shift.requirement</field>
        <field name="arch" type="xml">
            <search>
                <field name="attribute_id"/>
                <field name="template_id"/>
                <filter name="hard" string="Required"
                        domain="[('enforcement', '=', 'hard')]"/>
                <filter name="soft" string="Preferred"
                        domain="[('enforcement', '=', 'soft')]"/>
                <separator/>
                <filter name="each" string="Per Person"
                        domain="[('scope', '=', 'each')]"/>
                <filter name="team" string="Per Crew"
                        domain="[('scope', '=', 'team')]"/>
                <filter name="global" string="Applies To Every Shift"
                        domain="[('template_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_template" string="Shift Template"
                            context="{'group_by': 'template_id'}"/>
                    <filter name="group_attribute" string="Attribute"
                            context="{'group_by': 'attribute_id'}"/>
                    <filter name="group_scope" string="Scope"
                            context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_shift_requirement" model="ir.actions.act_window">
        <field name="name">Shift Requirements</field>
        <field name="res_model">restaurant.shift.requirement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_template': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Say what each shift needs</p>
            <p>Per person — "everyone holds a valid hygiene certificate" — or
            per crew — "at least one keyholder", "at most one trainee". A
            requirement with no shift template applies to every shift, which is
            how house rules are written once.</p>
        </field>
    </record>

</odoo>
