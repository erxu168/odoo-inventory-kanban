<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_task_warning" model="mail.template">
            <field name="name">Restaurant Tasks: Incomplete Warning</field>
            <field name="model_id" ref="model_restaurant_task_list"/>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">⚠️ Incomplete Tasks — {{ object.name }}</field>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;">
    <div style="background:#f0ad4e;color:#fff;padding:16px 24px;border-radius:8px 8px 0 0;">
        <h2 style="margin:0;">⚠️ Incomplete Tasks</h2>
    </div>
    <div style="background:#fff;border:1px solid #ddd;padding:24px;border-radius:0 0 8px 8px;">
        <p>Hi <strong>{{ object.employee_id.name }}</strong>,</p>
        <p>Your shift tasks are not fully complete:</p>
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f9fa;">
                <th style="text-align:left;padding:8px;border:1px solid #dee2e6;">Task</th>
                <th style="text-align:center;padding:8px;border:1px solid #dee2e6;">Status</th>
            </tr>
            {% for item in object.task_item_ids %}
            <tr>
                <td style="padding:8px;border:1px solid #dee2e6;">{{ item.name }}</td>
                <td style="padding:8px;border:1px solid #dee2e6;text-align:center;color:{{ 'green' if item.state == 'done' else 'red' }};">
                    {{ '✅' if item.state == 'done' else '❌' }}
                </td>
            </tr>
            {% endfor %}
        </table>
        <p><strong>Score: {{ "%.0f"|format(object.completion_score) }}%</strong>
            ({{ object.completed_tasks }}/{{ object.total_tasks }} tasks)</p>
    </div>
</div>
            </field>
        </record>

        <record id="mail_template_escalation" model="mail.template">
            <field name="name">Restaurant Tasks: Escalation Alert</field>
            <field name="model_id" ref="model_restaurant_task_list"/>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="subject">🚨 Escalation Level {{ ctx.get('escalation_level', '?') }} — Overdue Task</field>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;max-width:600px;margin:auto;">
    <div style="background:#d9534f;color:#fff;padding:16px 24px;border-radius:8px 8px 0 0;">
        <h2 style="margin:0;">🚨 Escalation Level {{ ctx.get('escalation_level', '?') }}</h2>
    </div>
    <div style="background:#fff;border:1px solid #ddd;padding:24px;border-radius:0 0 8px 8px;">
        <p>An overdue task requires attention:</p>
        <ul>
            <li><strong>Employee:</strong> {{ object.employee_id.name }}</li>
            <li><strong>Task List:</strong> {{ object.name }}</li>
            <li><strong>Location:</strong> {{ object.location_id.name or 'N/A' }}</li>
            <li><strong>Minutes Overdue:</strong> {{ ctx.get('minutes_overdue', '?') }}</li>
        </ul>
        <p>Please follow up immediately.</p>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
