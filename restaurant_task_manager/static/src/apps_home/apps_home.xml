<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="restaurant_task_manager.AppsHome">
        <div class="o_apps_home d-flex flex-column align-items-center w-100 py-5"
             style="min-height: 100vh; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-dark mb-2">Krawings</h1>
                <p class="text-muted fs-5">Select an app to get started</p>
            </div>
            <div class="d-flex flex-wrap justify-content-center gap-4 px-4"
                 style="max-width: 1200px;">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <div class="o_app_tile text-center p-4 bg-white rounded-4 shadow-sm"
                         style="width: 150px; cursor: pointer; transition: all 0.2s ease;"
                         t-on-click="() => this.onAppClick(app)">
                        <img t-if="app.webIconData"
                             t-att-src="app.webIconData"
                             class="rounded-3 mb-3"
                             style="width: 64px; height: 64px; object-fit: contain;"
                             t-att-alt="app.name"/>
                        <div t-else=""
                             class="d-flex align-items-center justify-content-center rounded-3 mb-3 mx-auto bg-primary bg-opacity-10"
                             style="width: 64px; height: 64px;">
                            <i class="fa fa-th-large fs-2 text-primary"/>
                        </div>
                        <div class="fw-semibold text-dark small text-truncate"
                             t-att-title="app.name"
                             t-esc="app.name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
