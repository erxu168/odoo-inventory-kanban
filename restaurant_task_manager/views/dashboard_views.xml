<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Today's Task Overview - Graph View -->
    <record id="view_task_item_graph_today" model="ir.ui.view">
        <field name="name">restaurant.task.item.graph.today</field>
        <field name="model">restaurant.task.item</field>
        <field name="arch" type="xml">
            <graph string="Today's Tasks" type="bar">
                <field name="state" type="col"/>
                <field name="employee_id" type="row"/>
            </graph>
        </field>
    </record>

    <!-- Weekly Trends - Graph View -->
    <record id="view_task_list_graph_weekly" model="ir.ui.view">
        <field name="name">restaurant.task.list.graph.weekly</field>
        <field name="model">restaurant.task.list</field>
        <field name="arch" type="xml">
            <graph string="Weekly Completion Trends" type="line">
                <field name="shift_start" interval="day" type="col"/>
                <field name="completion_score" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Today's Overview Action -->
    <record id="action_dashboard_today" model="ir.actions.act_window">
        <field name="name">Today's Overview</field>
        <field name="res_model">restaurant.task.item</field>
        <field name="view_mode">graph,list,form</field>
        <field name="domain">[
            ('create_date', '&gt;=', (context_today()).strftime('%Y-%m-%d')),
            ('create_date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))
        ]</field>
        <field name="context">{'graph_view_ref': 'restaurant_task_manager.view_task_item_graph_today'}</field>
    </record>

    <!-- Weekly Trends Action -->
    <record id="action_dashboard_weekly" model="ir.actions.act_window">
        <field name="name">Weekly Trends</field>
        <field name="res_model">restaurant.task.list</field>
        <field name="view_mode">graph,list,form</field>
        <field name="domain">[
            ('shift_start', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))
        ]</field>
        <field name="context">{'graph_view_ref': 'restaurant_task_manager.view_task_list_graph_weekly'}</field>
    </record>

    <!-- Overdue Tasks Action (for dashboard) -->
    <record id="action_dashboard_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Tasks</field>
        <field name="res_model">restaurant.task.item</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_overdue', '=', True)]</field>
    </record>

</odoo>
