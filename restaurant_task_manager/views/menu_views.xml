<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_restaurant_tasks_root"
              name="Restaurant Tasks"
              web_icon="restaurant_task_manager,static/description/icon.png"
              sequence="50"/>

    <!-- My Tasks -->
    <menuitem id="menu_my_tasks"
              name="My Tasks"
              parent="menu_restaurant_tasks_root"
              action="action_my_tasks"
              sequence="10"/>

    <!-- All Task Lists -->
    <menuitem id="menu_task_lists"
              name="Task Lists"
              parent="menu_restaurant_tasks_root"
              action="action_task_list_all"
              sequence="20"
              groups="group_task_manager"/>

    <!-- All Tasks -->
    <menuitem id="menu_all_tasks"
              name="All Tasks"
              parent="menu_restaurant_tasks_root"
              action="action_task_item_all"
              sequence="30"
              groups="group_task_manager"/>

    <!-- Dashboard -->
    <menuitem id="menu_dashboard"
              name="Dashboard"
              parent="menu_restaurant_tasks_root"
              sequence="40"
              groups="group_task_manager"/>

    <menuitem id="menu_dashboard_today"
              name="Today's Overview"
              parent="menu_dashboard"
              action="action_dashboard_today"
              sequence="10"/>

    <menuitem id="menu_dashboard_weekly"
              name="Weekly Trends"
              parent="menu_dashboard"
              action="action_dashboard_weekly"
              sequence="20"/>

    <menuitem id="menu_dashboard_overdue"
              name="Overdue Tasks"
              parent="menu_dashboard"
              action="action_dashboard_overdue"
              sequence="30"/>

    <!-- Configuration -->
    <menuitem id="menu_configuration"
              name="Configuration"
              parent="menu_restaurant_tasks_root"
              sequence="90"
              groups="group_task_manager"/>

    <menuitem id="menu_templates"
              name="Task Templates"
              parent="menu_configuration"
              action="action_task_list_template"
              sequence="10"/>

    <menuitem id="menu_escalation"
              name="Escalation Rules"
              parent="menu_configuration"
              action="action_escalation_rule"
              sequence="20"
              groups="group_task_admin"/>

</odoo>
