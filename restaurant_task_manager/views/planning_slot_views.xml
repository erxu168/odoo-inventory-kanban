<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit planning.slot form to add task list smart button -->
    <record id="view_planning_slot_form_inherit" model="ir.ui.view">
        <field name="name">planning.slot.form.inherit.tasks</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_task_lists" type="object"
                        class="oe_stat_button" icon="fa-tasks"
                        invisible="task_list_count == 0">
                    <field name="task_list_count" widget="statinfo"
                           string="Task Lists"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
